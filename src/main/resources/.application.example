server:
  port: 8080

app:
  file:
    # Folder tujuan untuk menyimpan hasil generate
    output-dir-spike: ${APP_OUTPUT_DIR:${user.home}/Documents/output_spike_chatai}
  k6:
    workspace-root: ${APP_OUTPUT_DIR:${user.home}/Documents/workspace/workspace_agentic_ai/performace_test_2_15_0_k6}

jira:
  # Contoh: https://company.atlassian.net
  development:
    enabled: true            # false = matikan sepenuhnya
    parallelism: 6
    max-tickets: 300
    main-branches: develop-support
  base-url:
  email:
  api-token:
  project-key:
  default-fix-version:
  max-results: 100
  max-pages: 50
  template: classpath:jira/Pre_Deployment_Checklist_template.xlsx
  cache-ttl-minutes: 10
  max-issues: 1000
  jql:
    # {fixVersion} diganti versi yang dipilih di dashboard
    all-tickets: '"Platform[Dropdown]" = Backend AND fixVersion = "{fixVersion}" AND worktype != Bug and status NOT IN (Cancelled, Closed) ORDER BY Sprint ASC'
    # Tiket DevOps biasanya ada di project lain. Kosong = tidak ditarik. Contoh:
    # devops: 'project = MD AND fixVersion = "{fixVersion}" ORDER BY created ASC'
    devops: '"Application[Dropdown]"="Cluster UBP" and "Apps Version[Dropdown]"={fixVersionShort} order by created DESC'
    # Kosong = diturunkan dari All Ticket (summary memuat "DDL")
    ddl: ''
    # Kosong = diturunkan dari All Ticket (summary memuat "Collection")
    db: ''
    # Kosong = diturunkan dari All Ticket (summary memuat hotfix / sanity)
    hotfix: ''
    # Tab Bugs Development / UAT; {fixVersion} mengikuti versi yang dipilih.
    bugs-development-uat: 'project = "Prodia Digital" AND affectedVersion = {fixVersion} AND "Platform[Dropdown]" = Backend ORDER BY createdDate DESC'
  # Nama field Jira; ID customfield dicari otomatis. Isi *-id hanya bila perlu memaksa ID tertentu.
  field-names:
    story-points: Story Points,Story point estimate
    sprint: Sprint
    using-prda-api: "Using PRDA API?"
  bugs:
    jql: '"Platform[Dropdown]"=Backend and project="PRDI Digital Ops" order by created DESC'
    max-issues: 2000
    critical-priorities: Highest,Critical,Blocker,High
    aging-days: 14
# Repository branch quality report: Bitbucket branch/pipeline + SonarQube metrics
repository:
  quality:
    enabled: ${REPOSITORY_QUALITY_ENABLED:true}
    bitbucket:
      base-url: https://api.bitbucket.org/2.0
      workspace: ${BITBUCKET_WORKSPACE:}
      # Uses the same read-only workspace/repository token as BitbucketService if available.
      token: ${BITBUCKET_API_TOKEN:${bitbucket.api.token:}}
      max-branch-pages: ${BITBUCKET_MAX_BRANCH_PAGES:20}
      pipeline-lookback: ${BITBUCKET_PIPELINE_LOOKBACK:20}
      # Default matches explicit pipeline step names such as "Unit Test" / "Unit-Test".
      # Override with BITBUCKET_UNIT_TEST_STEP_PATTERN if your pipeline uses another step name.
      unit-test-step-pattern: '${BITBUCKET_UNIT_TEST_STEP_PATTERN:(?i).*(unit.?test|unittest|testing).*}'
    sonar:
      base-url: ${SONAR_BASE_URL:}
      token: ${SONAR_TOKEN:}
      # Map Bitbucket repository slug to the exact SonarQube project key when they differ.
      project-keys: {}
      # Example:
      # project-keys:
      #   prdi-order-service: PRDI_Order_Service
    whitelist:
      file: ${REPOSITORY_COVERAGE_WHITELIST_FILE:./data/repository-coverage-whitelist.txt}
    environments:
      sit:
        # Dropdown SIT dibatasi ke dua branch ini; aplikasi tidak melakukan listing seluruh branch Bitbucket.
        branch: ${SIT_TARGET_BRANCH:develop-support}
        branches:
          - develop
          - develop-support
        selectable: true
      uat:
        branch-pattern: release/{fixVersion}
      prod:
        branch: main

bitbucket:
  api:
    token:
    username:
    password:

spring:
  application:
    name: genai
#  security:
#    user:
#      name:
#      password:
#      roles: ADMIN
  security:
    # false = hanya login Google/Bitbucket (disarankan di produksi)
    local-login-enabled: ${APP_LOCAL_LOGIN:true}
    # Allowlist login sosial (pisahkan dengan koma). Semua kosong = SEMUA login sosial ditolak.
    allowed-emails: ${APP_ALLOWED_EMAILS:}
    allowed-domains: ${APP_ALLOWED_DOMAINS:}
    # Slug workspace Bitbucket yang anggotanya boleh masuk lewat login Bitbucket
    allowed-bitbucket-workspaces: ${APP_ALLOWED_BITBUCKET_WORKSPACES:}
    admin-emails: ${APP_ADMIN_EMAILS:}
    require-email-verified: true
    pkce-providers: google
    # report-only = hanya mencatat pelanggaran di console browser; ganti ke enforce setelah semua halaman bersih
    csp-mode: ${APP_CSP_MODE:report-only}
    max-login-attempts: 5
    lockout-minutes: 15

  ai:
    # 1. Konfigurasi Google GenAI (Gemini)
    google:
      genai:
        api-key:
        project-id: gen-lang-client-0077630139
        # untuk standard GenAI API, api-key sudah cukup.
        chat:
          options:
            model: gemini-3.5-flash-lite # <-- Nama model harus diletakkan di dalam options ini
            temperature: 0.3
            # tool-choice: ANY      # (Uncomment jika Anda sudah implementasi @Bean function-nya)
            # functions:            # Format yang benar untuk mendaftarkan function di Spring AI
            #   - get_weather
            #   - get_forecast

    # 2. Konfigurasi Ollama (Diberi komentar sementara untuk menghindari konflik 2 model)
    # ollama:
    #   base-url: http://localhost:11434
    #   chat:
    #     options:
    #       model: llama3.1

# Spring Boot Actuator
management:
  endpoints:
    web:
      exposure:
        include: health,info,metrics
  endpoint:
    health:
      show-details: always

# Logging configuration
logging:
  level:
    "[com.hito.genai]": INFO
    "[org.springframework.ai]": DEBUG